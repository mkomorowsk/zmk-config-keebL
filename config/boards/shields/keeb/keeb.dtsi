/* keebL - shared devicetree for both halves
 *
 * One matrix transform covers the WHOLE keyboard (3 rows x 16 cols).
 * Left half uses matrix cols 0-7, right half uses cols 8-15
 * (the right overlay sets col-offset = <8>, so its local col N becomes N+8).
 *
 * The order of entries in `map` IS the keymap position order:
 *   Row 0:  pos  0- 5 (L)  |  pos  6-11 (R)
 *   Row 1:  pos 12-17 (L)  |  pos 18-23 (R)
 *   Row 2:  pos 24-31 (L)  |  pos 32-39 (R)
 *
 * Right half rows 0 and 1 use only its local cols 2-7 (-> 10-15).
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <3>;
        columns = <16>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                   RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)   RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
        >;
    };
};
